# =====================================================================================================
# Modelo do .env.prod (servidor de TESTE e, depois, produção). docs/DEPLOY.md, passo 2.
# Copie para .env.prod NO SERVIDOR e preencha. O .env.prod NUNCA vai para o Git (está no .gitignore).
# Nenhum valor abaixo é real: troque TODOS os "troque-...".
#
# Geradores (rode no servidor; cada comando imprime um valor novo):
#   Chave longa .......... python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#   Senha ................ python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   Endereço do admin .... python3 -c "import secrets; print('painel-' + secrets.token_urlsafe(24).replace('_', '-'))"
# =====================================================================================================

# --- Django --------------------------------------------------------------------------------------------
# Chave secreta (chave longa). Trocar invalida sessões e links de e-mail já enviados.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa
# Produção: SEMPRE False.
DJANGO_DEBUG=False
# Domínios aceitos (o primeiro também é usado pelo healthcheck).
DJANGO_ALLOWED_HOSTS=negociosdiarios.com.br,www.negociosdiarios.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://negociosdiarios.com.br,https://www.negociosdiarios.com.br
# Endereço público usado nos links dos e-mails.
SITE_URL=https://negociosdiarios.com.br
# HSTS: começa curto (1 hora). Depois do lançamento estável, subir para 31536000 (1 ano).
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMINIOS=False
DJANGO_HSTS_PRELOAD=False

# --- Proxy e IP real -----------------------------------------------------------------------------------
# Redes de onde o X-Real-IP é aceito (o nd_nginx, pela rede Docker). Não coloque redes públicas aqui.
PROXIES_CONFIAVEIS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Redes que o nd_nginx aceita como proxy (o nginx externo, também na rede Docker).
ND_PROXY_REDE_1=172.16.0.0/12
ND_PROXY_REDE_2=10.0.0.0/8
ND_PROXY_REDE_3=192.168.0.0/16
# Tamanho máximo de um envio (formulário de fotos: até 10 fotos de até 15 MB). Igual no nginx externo.
ND_LIMITE_UPLOAD=160m

# --- Servidor de TESTE ---------------------------------------------------------------------------------
# True = fora do Google (noindex em tudo, robots.txt "Disallow: /", sem sitemap). No lançamento: False.
SITE_NOINDEX=True
# Dados fictícios com DEBUG=False: só no servidor de teste (exige SITE_NOINDEX=True). No lançamento: False.
DEMO_NO_SERVIDOR=True
# Mostra os dados fictícios no site, com a faixa "Dados de demonstração". No lançamento: False.
MOSTRAR_DEMO=True
# Senha dos usuários demo criados pelo criar_dados_demo (Senha). Nunca a sua senha real.
DEMO_SENHA=troque-por-uma-senha

# --- Admin ---------------------------------------------------------------------------------------------
# Endereço secreto do admin (Endereço do admin): longo, aleatório e DIFERENTE do usado no seu PC.
ADMIN_URL=troque-painel-longo-e-aleatorio
# Código por e-mail para navegador novo. Em produção, SEMPRE True.
ADMIN_CODIGO_EMAIL=True

# --- Guia de Negócios ----------------------------------------------------------------------------------
# Chave do resumo (HMAC) do CPF dos autônomos (chave longa). Obrigatória; NUNCA troque depois de usar.
GUIA_CPF_CHAVE=troque-por-uma-chave-longa

# --- Banco (PostgreSQL + PostGIS) ----------------------------------------------------------------------
POSTGRES_DB=negocios
POSTGRES_USER=negocios
# Senha. Se tiver caracteres especiais, repita a mesma no DATABASE_URL (codificada para URL).
POSTGRES_PASSWORD=troque-por-uma-senha
DATABASE_URL=postgis://negocios:troque-por-uma-senha@db:5432/negocios

# --- Redis (fila do Celery e cache) --------------------------------------------------------------------
REDIS_PASSWORD=troque-por-uma-senha
REDIS_URL=redis://:troque-por-uma-senha@redis:6379/0

# --- Estáticos ------------------------------------------------------------------------------------------
# Nomes versionados (nd.<hash>.css): o nd_nginx guarda por 1 ano e cada deploy troca o que mudou. Sempre True aqui.
ESTATICOS_VERSIONADOS=True

# --- Arquivos (docs/adr/0002) --------------------------------------------------------------------------
# local = mídia no volume "media" (o nd_nginx serve) e arquivos privados no volume "privado" (nunca servido).
# s3 = Cloudflare R2: mídia no bucket público e privados no S3_BUCKET_PRIVADO (sem domínio público).
ARMAZENAMENTO=local
# Só com ARMAZENAMENTO=s3:
# S3_ENDPOINT_URL=https://<id-da-conta>.r2.cloudflarestorage.com
# S3_BUCKET=midia
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_DOMINIO_PUBLICO=midia.negociosdiarios.com.br
# S3_REGIAO=auto
# S3_BUCKET_PRIVADO=privado

# --- E-mail (SMTP; sai pela fila do Celery) ------------------------------------------------------------
# Ex.: Brevo (smtp-relay.brevo.com, porta 587, TLS). O admin depende disto (código por e-mail).
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=troque
EMAIL_HOST_PASSWORD=troque
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_BACKEND_REAL=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Negócios Diários <nao-responda@negociosdiarios.com.br>

# --- Contatos públicos e Pix ---------------------------------------------------------------------------
SITE_WHATSAPP=
SITE_ENDERECO=
SITE_CNPJ=
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=
