# Copie para .env e preencha. NUNCA commite o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Endereço secreto do admin (sem barras; /admin/ dá 404). Este valor é público (está no Git):
# gere um NOVO para cada ambiente com
#   python -c "import secrets; print('painel-' + secrets.token_hex(8))"
ADMIN_URL=painel-150e2f96cbf410e4
# Código por e-mail para navegador novo no admin (padrão: True). Em dev o e-mail chega no
# Mailpit (http://localhost:8025). Pode pôr False em dev; em produção, SEMPRE True.
ADMIN_CODIGO_EMAIL=True
# Dados de demonstração (só em dev; proibido com DJANGO_DEBUG=False). Regra no CLAUDE.md.
# MOSTRAR_DEMO=True: a home mostra lojas e anúncios fictícios de core/dados/demo.json.
MOSTRAR_DEMO=True
# Senha dos usuários criados pelo criar_dados_demo (escolha uma forte; nunca a sua real).
DEMO_SENHA=
# Contatos públicos (/contato/ e documentos legais). Vazio = "em breve"/"a informar".
# WhatsApp em E.164 (ex.: +5565999999999); CNPJ só dígitos.
SITE_WHATSAPP=
SITE_ENDERECO=
SITE_CNPJ=
POSTGRES_DB=negocios
POSTGRES_USER=negocios
POSTGRES_PASSWORD=troque
DATABASE_URL=postgis://negocios:troque@db:5432/negocios
# Redis: fila e resultados do Celery.
REDIS_PASSWORD=troque
REDIS_URL=redis://:troque@redis:6379/0

# Mídia (docs/adr/0002-armazenamento-midia.md): local (dev, pasta media/) ou s3 (produção).
ARMAZENAMENTO=local
# Só com ARMAZENAMENTO=s3 (Cloudflare R2: painel R2 → Manage API tokens):
# S3_ENDPOINT_URL=https://<id-da-conta>.r2.cloudflarestorage.com
# S3_BUCKET=midia
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_DOMINIO_PUBLICO=midia.negociosdiarios.com.br   # vazio = URLs assinadas e temporárias
# S3_REGIAO=auto

# E-mail: sai sempre pela fila do Celery; o worker envia por SMTP.
# Dev: Mailpit (sem usuário/senha). Produção: Brevo (smtp-relay.brevo.com) ou
# Amazon SES (email-smtp.<região>.amazonaws.com), porta 587 com EMAIL_USE_TLS=True.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Negócios Diários <nao-responda@negociosdiarios.com.br>

# Mercado Pago: use credenciais de TESTE em dev
MP_ACCESS_TOKEN=TEST-xxxx
MP_WEBHOOK_SECRET=xxxx
