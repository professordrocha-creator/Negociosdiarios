# Imagem de PRODUÇÃO (web, worker e beat; docs/DEPLOY.md). O Dockerfile comum continua sendo o de dev.
# Dois estágios: o "construtor" instala as dependências com o uv; a imagem final só recebe o virtualenv
# pronto e o código (sem uv, sem cache, sem ferramentas de desenvolvimento), roda com usuário sem root.

# --- Estágio 1: dependências -------------------------------------------------------------------------
FROM python:3.12.12-slim-bookworm AS construtor

COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
# Só as dependências de produção (sem pytest/ruff), exatamente as do uv.lock.
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-install-project --no-dev

# --- Estágio 2: imagem final ------------------------------------------------------------------------
FROM python:3.12.12-slim-bookworm

# GDAL/GEOS/PROJ (GeoDjango + PostGIS) e libcairo2 (favicon a partir do SVG). Nada além disso.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gdal-bin libcairo2 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=construtor /opt/venv /opt/venv
WORKDIR /app
COPY . .

# Usuário sem privilégios (docs/SEGURANCA.md §3). Pastas dos volumes (mídia pública, arquivos privados e
# estáticos) já nascem dele: o volume nomeado herda o dono na primeira subida.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/media /app/privado /app/staticfiles \
    && chown -R app:app /app

USER app

# Estáticos coletados na imagem (confere que o collectstatic funciona no build). Variáveis falsas só para o
# settings carregar: nada disso vai para a imagem como configuração (o .env.prod é lido na subida).
RUN DJANGO_SECRET_KEY=so-para-o-build ADMIN_URL=build-somente \
    DATABASE_URL=postgis://build:build@localhost:5432/build REDIS_URL=redis://localhost:6379/0 \
    python manage.py collectstatic --noinput

EXPOSE 8000
# Gunicorn: 3 processos (VPS compartilhada), 60 s de limite por requisição (upload de fotos no 4G).
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "60", \
     "--access-logfile", "-", "--error-logfile", "-"]
